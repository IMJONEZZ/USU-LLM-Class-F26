# Allowlist the training build context: no corpus, checkpoints, caches, envs,
# credentials or local reports are sent to the builder.
**
!Dockerfile.training
!Dockerfile.training.dockerignore
!pyproject.toml
!requirements-training.lock
!src/
!src/*.py
!tests/
!tests/*.py
# Never load host-generated bytecode inside a different Python environment.
**/__pycache__
**/*.pyc
**/*.pyo
